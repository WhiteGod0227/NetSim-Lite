{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "excludeFiles": "{deliverables/**,NetSim_Lite_Submission/**,frontend/node_modules/**,frontend/tests/**,frontend/scripts/**,tests/**,scripts/**,.tools/**,.venv/**,**/*.zip,**/*.log}"
    }
  }
}
