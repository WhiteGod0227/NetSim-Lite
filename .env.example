# Docker Compose host port. The container always listens on port 8000.
NETSIM_PUBLIC_PORT=8080

# For native production startup, set these in your shell or hosting dashboard:
# PORT=8000
# HOST=0.0.0.0
# NETSIM_STATIC_DIR=/absolute/path/to/frontend/dist
# .env files are not automatically loaded by the native Python command.
